<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Paneli</title>
    <!-- Standart Bootstrap ve İkonlar -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <!-- Sayfayı yan yana ikiye bölüyoruz (Sidebar ve İçerik) -->
    <div class="d-flex" style="min-height: 100vh;">
        
        <!-- SOL MENÜ (SIDEBAR) -->
        <div class="bg-dark text-white p-3 shadow-lg" style="width: 260px;">
            <h4 class="text-info text-center fw-bolder mb-4 mt-2">
                <i class="bi bi-gear-fill me-2"></i>Kontrol Paneli
            </h4>
            <hr class="border-secondary" />
            <ul class="nav nav-pills flex-column mb-auto fs-5">
                <li class="nav-item mb-2">
                    <a href="/Admin/Index" class="nav-link text-white">
                        <i class="bi bi-speedometer2 me-3 text-info"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a href="/Admin/Projects" class="nav-link text-white">
                        <i class="bi bi-folder me-3 text-info"></i> Projeler
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a href="/Admin/Messages" class="nav-link text-white">
                        <i class="bi bi-envelope me-3 text-info"></i> Mesajlar
                    </a>
                </li>
                <!-- Siteye Geri Dönüş Butonu -->
                <li class="nav-item mt-5">
                    <a href="/" class="nav-link text-warning" target="_blank">
                        <i class="bi bi-box-arrow-up-right me-3"></i> Siteye Dön
                    </a>
                </li>
            </ul>
        </div>
        
        <!-- ANA İÇERİK ALANI (Tıkladığımız sayfalar burada açılacak) -->
        <div class="flex-grow-1 p-5">
            @RenderBody()
        </div>

    </div>
    
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Sayfalara özel script eklemek istersek diye render alanı -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
