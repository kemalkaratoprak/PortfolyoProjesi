@model List<PortfolyoProjesi.Models.Project>

@{
    ViewData["Title"] = "Yazılım Geliştirici Portfolyosu";
}

<header class="py-5 mb-5" style="background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%); border-radius: 20px; border: 1px solid #333;">
    <div class="container px-5">
        <div class="row gx-5 align-items-center justify-content-center">
            <div class="col-lg-8">
                <div class="my-5 text-center text-xl-start">
                    <h1 class="display-5 fw-bolder text-white mb-2">Geleceği Kodla İnşa Ediyorum</h1>
                    <p class="lead fw-normal text-white-50 mb-4">ASP.NET Core ve SQL Server ile modern, güvenli ve ölçeklenebilir çözümler.</p>
                    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center justify-content-xl-start">
                        <a class="btn btn-info btn-lg px-4 me-sm-3 fw-bold" href="#projects">Projelerimi Gör</a>
                        <a class="btn btn-outline-light btn-lg px-4" href="#contact">İletişim</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<section class="py-5 bg-dark" id="about">
    <div class="container px-5 my-5">
        <div class="row gx-5 align-items-center">
            <div class="col-lg-5 text-center mb-5 mb-lg-0">
                <!-- STORY ÖZELLİKLİ PROFİL RESMİ -->
                <div class="position-relative d-inline-block">
                    <div class="story-ring p-1 rounded-circle shadow-lg" style="background: linear-gradient(45deg, #0dcaf0, #0d6efd, #6610f2); cursor: pointer;" id="profileImage" title="Hikayeyi Gör">
                        <img class="img-fluid rounded-circle border border-dark border-4 bg-dark" src="~/img/profil.jpeg" alt="Kemal Karatoprak" style="width: 280px; height: 280px; object-fit: cover;" />
                    </div>
                    <div class="position-absolute bottom-0 end-0 bg-info text-dark p-2 rounded-circle shadow" style="z-index: 5;">
                        <span class="fw-bold">🚀👨‍💻</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <h2 class="fw-bolder text-info mb-3">Ben Kimim?</h2>
                <p class="lead fw-normal text-white mb-4">
                    Merhaba! Ben <strong>Kemal Karatoprak</strong>. Geleceği kodlarla inşa etmeye meraklı, ASP.NET Core ve modern web teknolojileri üzerine odaklanmış bir yazılım geliştiriciyim.
                </p>
                <p class="text-white-50 mb-4">
                    Karmaşık problemleri basit ve kullanıcı dostu çözümlere dönüştürmeyi seviyorum. Veri tabanı mimarileri, backend süreçleri ve şık kullanıcı arayüzleri oluşturmak benim için bir tutku.
                </p>
                
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex gap-3 align-items-center">
                        <a href="#contact" class="btn btn-outline-info">Bana Ulaşın</a>
                        <a href="~/files/Kemal_Karatoprak_CV.pdf" download="Kemal_Karatoprak_CV.pdf" class="btn btn-link text-info text-decoration-none fw-bold">
                            <i class="bi bi-file-earmark-pdf-fill"></i> CV İndir (PDF)
                        </a>
                    </div>
                    
                    <div class="social-links mt-2">
                        <a href="https://github.com/kemalkaratoprak" target="_blank" class="me-3 text-light fs-2 social-icon" title="GitHub">
                            <i class="fab fa-github"></i>
                        </a>
                        <a href="https://linkedin.com/in/kemalkaratoprak" target="_blank" class="me-3 text-info fs-2 social-icon" title="LinkedIn">
                            <i class="fab fa-linkedin"></i>
                        </a>
                        <a href="https://x.com/kemalk27" target="_blank" class="text-light fs-2 social-icon" title="X (Twitter)">
                            <i class="fab fa-x-twitter"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-dark border-bottom border-secondary mb-5">
    <div class="container px-5">
        <div class="text-center mb-5">
            <h2 class="fw-bolder text-info">Teknik Yetkinlikler</h2>
            <p class="lead fw-normal text-muted mb-0">Programlama dilleri, frameworkler ve kullandığım araçlar</p>
        </div>
        
        <div class="row gx-5">
            <div class="col-lg-6 mb-5">
                <div class="card h-100 bg-dark border-secondary shadow-lg transform-hover">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="feature bg-info bg-gradient text-dark rounded-3 me-3 shadow" style="width: 60px; height: 60px;">
                                <i class="bi bi-code-slash fs-3"></i>
                            </div>
                            <h3 class="h4 text-info mb-0 fw-bold">Programlama Dilleri</h3>
                        </div>
                        <ul class="list-unstyled text-white-50 fs-6">
                            <li class="mb-3">
                                <span class="text-white fw-bold">Python:</span> <span class="small">(İleri) Pandas, NumPy, Selenium ile Veri İşleme & Otomasyon</span>
                            </li>
                            <li class="mb-3">
                                <span class="text-white fw-bold">C#:</span> <span class="small">(Orta) .NET Core & MVC ile Backend Geliştirme</span>
                            </li>
                            <li class="mb-3">
                                <span class="text-white fw-bold">JavaScript:</span> <span class="small">(Orta) İnteraktif Web Çözümleri</span>
                            </li>
                            <li>
                                <span class="text-white fw-bold">HTML5 / CSS3:</span> <span class="small">(Modern Tasarımlar)</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-5">
                <div class="card h-100 bg-dark border-secondary shadow-lg transform-hover">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="feature bg-info bg-gradient text-dark rounded-3 me-3 shadow" style="width: 60px; height: 60px;">
                                <i class="bi bi-stack fs-3"></i>
                            </div>
                            <h3 class="h4 text-info mb-0 fw-bold">Frameworkler & Teknolojiler</h3>
                        </div>
                        <ul class="list-unstyled text-white-50 fs-6">
                            <li class="mb-3">
                                <span class="text-white fw-bold">Web Geliştirme:</span> <span class="small">ASP.NET Core MVC Mimarisi</span>
                            </li>
                            <li class="mb-3">
                                <span class="text-white fw-bold">ORM:</span> <span class="small">Entity Framework Core</span>
                            </li>
                            <li class="mb-3">
                                <span class="text-white fw-bold">Frontend:</span> <span class="small">Bootstrap 5, CSS Animations</span>
                            </li>
                            <li>
                                <span class="text-white fw-bold">Veri Tabanı:</span> <span class="small">SQL Server (T-SQL, DB Design)</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-12">
                <div class="card bg-dark border-secondary shadow-lg transform-hover">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="feature bg-info bg-gradient text-dark rounded-3 me-3 shadow" style="width: 60px; height: 60px;">
                                <i class="bi bi-tools fs-3"></i>
                            </div>
                            <h3 class="h4 text-info mb-0 fw-bold">Araçlar & Ortamlar</h3>
                        </div>
                        <div class="row text-center text-white-50">
                            <div class="col-md-4 border-end border-secondary mb-3 mb-md-0">
                                <p class="fw-bold text-white mb-1">Versiyon Kontrol</p>
                                <p class="small mb-0">Git, GitHub</p>
                            </div>
                            <div class="col-md-4 border-end border-secondary mb-3 mb-md-0">
                                <p class="fw-bold text-white mb-1">Geliştirme Ortamları</p>
                                <p class="small mb-0">VS Code, Visual Studio, PyCharm</p>
                            </div>
                            <div class="col-md-4">
                                <p class="fw-bold text-white mb-1">Analiz & Tasarım</p>
                                <p class="small mb-0">SSMS, Draw.io</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="projects" class="py-5 bg-dark">
    <div class="container px-4">
        <h2 class="fw-bolder mb-5 text-center text-info">Öne Çıkan Çalışmalarım</h2>
        <div class="row gx-4">
            @foreach (var proje in Model)
            {
                <div class="col-lg-4 mb-5">
                    <div class="card h-100 shadow-lg border-secondary bg-dark text-white">
                        <img class="card-img-top" src="@proje.ImageUrl" style="height: 200px; object-fit: cover;" />
                        <div class="card-body p-4">
                            <h5 class="card-title text-info">@proje.Title</h5>
                            <p class="text-white-50 small">@proje.Description</p>
                            <div class="d-flex gap-2 mt-3">
                                @if (!string.IsNullOrEmpty(proje.GithubUrl))
                                {
                                    <a href="@proje.GithubUrl" target="_blank" class="btn btn-sm btn-outline-light">
                                        <i class="fab fa-github"></i> GitHub
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(proje.LiveUrl))
                                {
                                    <a href="@proje.LiveUrl" target="_blank" class="btn btn-sm btn-info fw-bold">
                                        <i class="bi bi-globe"></i> Canlı Gör
                                    </a>
                                }
                            </div>    
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5 bg-dark" id="contact">
    <div class="container px-5">
        <div class="bg-secondary rounded-4 py-5 px-4 px-md-5 shadow-lg border border-info">
            <div class="text-center mb-5">
                <h2 class="fw-bolder text-white">Bana Ulaşın</h2>
                @if (TempData["MessageSent"] != null)
                {
                    <script>
                        document.addEventListener("DOMContentLoaded", function() {
                            Swal.fire({
                                title: 'Başarılı!',
                                text: '@Html.Raw(TempData["MessageSent"])',
                                icon: 'success',
                                confirmButtonText: 'Tamam',
                                confirmButtonColor: '#0dcaf0',
                                background: '#212529',
                                color: '#ffffff'
                            });
                        });
                    </script>
                }        
            </div>
            <div class="row gx-5 justify-content-center">
                <div class="col-lg-8 col-xl-6">
                    <form asp-action="SendMessage" asp-controller="Home" method="post">
                        
                        <div style="position: absolute; left: -9999px;" aria-hidden="true">
                            <label for="CatchSpamTrap">Güvenlik Alanı</label>
                            <input type="text" name="CatchSpamTrap" id="CatchSpamTrap" tabindex="-1" autocomplete="off" />
                        </div>

                        <div class="form-floating mb-3">
                            <input class="form-control bg-dark text-white border-secondary" name="Name" id="name" type="text" placeholder="Ad Soyad" required />
                            <label for="name">Ad Soyad</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input class="form-control bg-dark text-white border-secondary" name="Email" id="email" type="email" placeholder="E-posta" required />
                            <label for="email">E-posta</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input class="form-control bg-dark text-white border-secondary" name="Subject" id="subject" type="text" placeholder="Konu" required />
                            <label for="subject">Konu</label>
                        </div>
                        <div class="form-floating mb-3">
                            <textarea class="form-control bg-dark text-white border-secondary" name="Message" id="message" style="height: 10rem" placeholder="Mesaj" required></textarea>
                            <label for="message">Mesaj</label>
                        </div>
                        <div class="d-grid"><button class="btn btn-info btn-lg fw-bold" type="submit">Gönder</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- STORY MODAL HTML & CSS -->
<div id="storyModal" class="story-modal">
    <div class="story-content shadow-lg">
        <div class="story-progress-container">
            <div id="storyProgressBar" class="story-progress-bar"></div>
        </div>
        
        <img src="~/img/profil.jpeg" alt="Story" class="story-image" />
        
        <button id="closeStory" class="close-story-btn"><i class="bi bi-x-lg"></i></button>

        <div class="story-text">
            <p class="mb-0 fw-bold">Şu anda yeni bir yapay zeka projesi kodluyorum! ☕💻</p>
        </div>
    </div>
</div>

<style>
    .transform-hover {
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        will-change: transform, box-shadow;
        backface-visibility: hidden;
    }

    .transform-hover:hover {
        transform: translateY(-8px) scale(1.01);
        box-shadow: 0 15px 30px rgba(13, 202, 240, 0.15) !important;
        border-color: #0dcaf0 !important;
    }

    .social-icon {
        transition: transform 0.3s ease, color 0.3s ease;
        display: inline-block;
        text-decoration: none !important;
        outline: none !important;
    }

    .social-icon:hover {
        transform: translateY(-5px);
        color: inherit;
    }

    .fa-github:hover { color: #6e5494 !important; }
    .fa-linkedin:hover { color: #0077b5 !important; }
    .fa-x-twitter:hover { color: #ffffff !important; }

    .feature {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .feature i {
        line-height: 0;
        display: inline-block;
    }

    /* STORY MODAL CSS */
    .story-ring {
        transition: transform 0.3s ease, filter 0.3s ease;
    }
    .story-ring:hover {
        transform: scale(1.03);
        filter: brightness(1.2);
    }

    .story-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.95);
        backdrop-filter: blur(8px);
    }

    .story-content {
        position: relative;
        margin: 2% auto;
        top: 50%;
        transform: translateY(-50%);
        width: 100%;
        max-width: 400px;
        height: 85vh;
        max-height: 750px;
        background-color: #111;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 0 40px rgba(13, 202, 240, 0.4);
    }

    .story-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .story-progress-container {
        position: absolute;
        top: 15px;
        left: 15px;
        right: 15px;
        height: 4px;
        background-color: rgba(255, 255, 255, 0.3);
        border-radius: 4px;
        z-index: 10;
        overflow: hidden;
    }

    .story-progress-bar {
        height: 100%;
        width: 0%;
        background-color: #fff;
        border-radius: 4px;
    }

    .close-story-btn {
        position: absolute;
        top: 25px;
        right: 15px;
        background: transparent;
        border: none;
        color: white;
        font-size: 26px;
        cursor: pointer;
        z-index: 10;
        text-shadow: 0 2px 4px rgba(0,0,0,0.8);
    }

    .story-text {
        position: absolute;
        bottom: 30px;
        left: 20px;
        right: 20px;
        text-align: center;
        color: white;
        text-shadow: 0 2px 5px rgba(0,0,0,0.9);
        z-index: 10;
    }
</style>

<!-- STORY JAVASCRIPT -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const profileImg = document.getElementById('profileImage');
        const storyModal = document.getElementById('storyModal');
        const closeStoryBtn = document.getElementById('closeStory');
        const progressBar = document.getElementById('storyProgressBar');
        
        let progressInterval;
        const storyDuration = 5000; // 5 Saniye

        profileImg.addEventListener('click', function() {
            storyModal.style.display = "block";
            progressBar.style.width = "0%";
            document.body.style.overflow = "hidden";
            
            let width = 0;
            const intervalTime = 50; 
            const step = (100 / (storyDuration / intervalTime));

            progressInterval = setInterval(() => {
                width += step;
                progressBar.style.width = width + "%";
                
                if (width >= 100) {
                    closeStory();
                }
            }, intervalTime);
        });

        function closeStory() {
            storyModal.style.display = "none";
            clearInterval(progressInterval);
            document.body.style.overflow = "auto";
        }

        closeStoryBtn.addEventListener('click', closeStory);
        
        window.addEventListener('click', function(e) {
            if (e.target === storyModal) {
                closeStory();
            }
        });
    });
</script>